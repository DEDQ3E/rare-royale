{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["games/**/*.ts", "games/**/*.tsx", "games/**/*.d.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
